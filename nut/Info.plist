<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>VoiceTranscriptionProvider</key>
	<string>whisperkit</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Nut uses your microphone so you can talk to it</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Nut needs screen recording access to see your screen and help you.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Nut uses speech recognition to transcribe your voice when you talk to it</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allows the app to reach the local Worker (wrangler dev) at
		     http://localhost:8787 over plain HTTP. Local networking only;
		     does not loosen security for arbitrary internet hosts. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
